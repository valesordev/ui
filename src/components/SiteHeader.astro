---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<header class:list={['w-full fixed top-0 z-10 transition-all duration-300', className]}>
  <div class="container mx-auto flex justify-between items-center px-4 md:px-6 py-4">
    <slot name="logo" />
    <nav>
      <slot name="nav" />
    </nav>
  </div>
</header>
